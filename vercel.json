{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "public/*.php", "use": "vercel-php@0.9.0" },
    { "src": "public/assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.php" },
    { "src": "/([a-z0-9-]+\\.php)", "dest": "/public/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" }
  ]
}
