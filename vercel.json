{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "public/vercel-router.php", "use": "vercel-php@0.9.0" },
    { "src": "public/assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/(?:([a-z0-9-]+)\\.php)?", "dest": "/public/vercel-router.php?vercel_page=$1" }
  ]
}
